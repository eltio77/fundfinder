# Single image used by docker compose (local) and Vercel (Container Runtime).

# --- React frontend -> static files
# Base images are pinned by digest (Dependabot bumps them); tags kept for readability.
FROM node:26-alpine@sha256:6f08a523443ddedf52941874c203475b0ad503e859ad70cb26ab8be9a517dbd5 AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

# --- Python dependencies
FROM python:3.14-slim@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170 AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.1@sha256:4a1f3666816dafadd20ceb71eac9a7d56d7ef30279f7d64048519ab901ada336 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=0
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY fundfinder ./fundfinder
COPY scripts ./scripts
COPY --from=web /web/dist ./web/dist

# --- runtime
# Vercel routes to port 80 unless PORT is set in the project settings (an ENV in
# this image doesn't change the routing), so default to 80. Binding a port below
# 1024 needs root; each Vercel instance runs in its own microVM. compose sets
# PORT=8000.
FROM python:3.14-slim@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170
WORKDIR /app
COPY --from=build /app /app
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
EXPOSE 80
CMD ["sh", "-c", "exec uvicorn fundfinder.main:app --host 0.0.0.0 --port ${PORT:-80} --proxy-headers --forwarded-allow-ips='*'"]
