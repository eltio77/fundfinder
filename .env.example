# Copy to .env (never commit .env).

# Atlas connection string for your Free cluster (Atlas UI → Connect → Drivers).
# docker compose overrides this for the app container to use the local "mongo" service.
# To run scripts from the host against local Docker Mongo, use:
#   MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=fund_finder

EMBED_MODEL=voyage-4

# Used by local Docker Mongo (compose.yaml) for Automated Embedding. On Atlas the key is
# registered in the Atlas UI instead. Without a payment method Voyage allows only 3 req/min.
VOYAGE_API_KEY=
# Only for keys created directly at voyageai.com (Atlas-issued keys use the default):
# VOYAGE_EMBEDDING_PROVIDER_ENDPOINT=https://api.voyageai.com/v1/embeddings

# Port for the Docker image (defaults to 80, Vercel's default; compose sets 8000).
# Not used by `uv run uvicorn`, which takes --port.
# PORT=80
