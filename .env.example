# Copy to .env (never commit .env).

# Atlas connection string for your Free cluster (Atlas UI → Connect → Drivers).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=fund_finder

# "auto" = Atlas Automated Embedding (the Voyage key is registered in the Atlas UI, not here).
# "client" = fallback: the app calls Voyage itself using VOYAGE_API_KEY.
EMBEDDING_MODE=auto
EMBED_MODEL=voyage-4
VOYAGE_API_KEY=

# Port uvicorn listens on (Vercel routes to $PORT).
PORT=8000
